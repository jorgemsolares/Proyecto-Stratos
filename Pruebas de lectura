            Write-Host ("[{0}] Subido a GitHub automáticamente." -f (Get-Date -Format 'HH:mm:ss')) -ForegroundColor Green
        } else {
            Write-Host ("[{0}] push falló (revisa credenciales)." -f (Get-Date -Format 'HH:mm:ss')) -ForegroundColor Yellow
        }
    } else {
        Write-Host ("[{0}] Sin cambios nuevos; nada que subir." -f (Get-Date -Format 'HH:mm:ss')) -ForegroundColor DarkGray
    }
}

Write-Host "Vigilando la bitácora (guardar MEMORIA.md dispara la subida)..."
Write-Host "  Archivo: $Bitacora"
Write-Host "  Presiona Ctrl+C para detener."
Write-Host ""

$watcher = New-Object System.IO.FileSystemWatcher
$watcher.Path = (Split-Path $Bitacora)
$watcher.Filter = (Split-Path $Bitacora -Leaf)
$watcher.NotifyFilter = [System.IO.NotifyFilters]::LastWrite -bor [System.IO.NotifyFilters]::Size -bor [System.IO.NotifyFilters]::FileName
$watcher.EnableRaisingEvents = $true

# Evita disparos dobles: espera un pequeño silencio tras detectar el cambio
$script:ultimoDisparo = 0
$block = {
    $ahora = [Environment]::TickCount
    if (($ahora - $script:ultimoDisparo) -lt ($script:EsperaSegundos * 1000)) { return }
    $script:ultimoDisparo = $ahora
    Start-Sleep -Seconds $script:EsperaSegundos
    Subir-GitHub
}

Register-ObjectEvent $watcher "Changed" -Action $block | Out-Null

# Mantiene el script corriendo
try {
    while ($true) { Start-Sleep -Seconds 1 }
} finally {
    $watcher.EnableRaisingEvents = $false
    $watcher.Dispose()
}
